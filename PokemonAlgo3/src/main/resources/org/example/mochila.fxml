<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #40B0A0;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.MochilaController">
   <children>
      <AnchorPane layoutX="198.0" layoutY="1.0" prefHeight="311.0" prefWidth="401.0" style="-fx-background-color: #F0C870; -fx-background-radius: 5;">
         <children>
            <ListView fx:id="listaItems" layoutX="13.0" layoutY="8.0" onMouseClicked="#confirmarUso" prefHeight="289.0" prefWidth="377.0" style="-fx-background-color: #F8F8C8;" />
         </children>
      </AnchorPane>
      <AnchorPane layoutY="313.0" prefHeight="88.0" prefWidth="600.0" style="-fx-background-color: #0078C0; -fx-border-radius: 10;">
         <children>
            <Label fx:id="descripcionItem" layoutX="85.0" prefHeight="88.0" prefWidth="515.0" text="descripcion" textFill="WHITE">
               <font>
                  <Font size="23.0" />
               </font></Label>
            <AnchorPane layoutX="12.0" layoutY="15.0" prefHeight="63.0" prefWidth="62.0" style="-fx-background-color: white; -fx-background-radius: 5;">
               <children>
                  <ImageView fx:id="imagenItem" fitHeight="66.0" fitWidth="67.0" layoutX="2.0" layoutY="-3.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@Imgs/Bag_Potion_Sprite.png" />
                     </image>
                  </ImageView>
               </children>
            </AnchorPane>
            <AnchorPane layoutX="462.0" layoutY="8.0" prefHeight="77.0" prefWidth="129.0">
               <children>
                  <ImageView fx:id="fondoConfirmacion" fitHeight="77.0" fitWidth="129.0" pickOnBounds="true" visible="false">
                     <image>
                        <Image url="@Imgs/opciones.png" />
                     </image>
                  </ImageView>
                  <Button fx:id="salir" layoutX="16.0" layoutY="15.0" mnemonicParsing="false" onMouseClicked="#volverABatalla" prefHeight="48.0" prefWidth="95.0" style="-fx-background-color: #625795; -fx-background-radius: 20;" text="Salir" textFill="WHITE">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Button>
                  <Button fx:id="confirmarNo" layoutX="68.0" layoutY="39.0" mnemonicParsing="false" onMouseClicked="#ocultarConfirmacion" prefHeight="25.0" prefWidth="50.0" text="no" visible="false" />
                  <Button fx:id="confirmarSi" layoutX="13.0" layoutY="39.0" mnemonicParsing="false" onMouseClicked="#elegirPokemonItem" prefHeight="25.0" prefWidth="50.0" text="si" visible="false" />
                  <Label fx:id="confirmarUsoLabel" alignment="CENTER" layoutX="20.0" layoutY="14.0" prefHeight="17.0" prefWidth="95.0" text="usar este item?" visible="false">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </AnchorPane>
         </children>
      </AnchorPane>
      <ImageView fitHeight="274.0" fitWidth="177.0" layoutX="14.0" layoutY="69.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Imgs/FRLG_Key_Items_pocket_M.png" />
         </image>
      </ImageView>
      <AnchorPane layoutX="21.0" layoutY="7.0" prefHeight="54.0" prefWidth="190.0" style="-fx-background-color: #F0C870; -fx-background-radius: 5;">
         <children>
            <Label alignment="CENTER" layoutX="8.0" layoutY="3.0" prefHeight="48.0" prefWidth="161.0" text="Items" textFill="WHITE">
               <font>
                  <Font size="29.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
