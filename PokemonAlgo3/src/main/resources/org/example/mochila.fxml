<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="main" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.MochilaController">
   <children>
      <ListView fx:id="listaItems" layoutX="200.0" layoutY="-1.0" onMouseClicked="#confirmarUso" prefHeight="314.0" prefWidth="400.0" />
      <AnchorPane layoutY="313.0" prefHeight="75.0" prefWidth="600.0">
         <children>
            <ImageView fx:id="imagenItem" fitHeight="88.0" fitWidth="127.0" pickOnBounds="true" preserveRatio="true" />
            <Label fx:id="descripcionItem" layoutX="154.0" prefHeight="88.0" prefWidth="446.0" text="descripcion" />
            <AnchorPane fx:id="salirDeMochila" layoutX="472.0" prefHeight="88.0" prefWidth="127.0">
               <children>
                  <Button fx:id="salir" layoutX="23.0" layoutY="22.0" mnemonicParsing="false" onMouseClicked="#volverABatalla" prefHeight="44.0" prefWidth="82.0" text="Salir" />
                  <Button fx:id="confirmarNo" layoutX="66.0" layoutY="45.0" mnemonicParsing="false" onMouseClicked="#ocultarConfirmacion" prefHeight="17.0" prefWidth="59.0" text="no" visible="false" />
                  <Label fx:id="confirmarUsoLabel" alignment="CENTER" layoutX="19.0" layoutY="14.0" prefHeight="17.0" prefWidth="95.0" text="usar este item?" visible="false" />
                  <Button fx:id="confirmarSi" layoutY="45.0" mnemonicParsing="false" onMouseClicked="#elegirPokemonItem" prefHeight="25.0" prefWidth="59.0" text="si" visible="false" />
               </children>
            </AnchorPane>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
