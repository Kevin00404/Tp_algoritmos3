            <Image url="@Imgs/texto.png" />
         </image>
      </ImageView>
      <Button fx:id="salirDelJuego" alignment="BOTTOM_CENTER" layoutX="400.0" layoutY="225.0" mnemonicParsing="false" onMouseClicked="#salir" prefHeight="22.0" prefWidth="120.0" style="-fx-background-radius: 50; -fx-background-color: #625795;" text="Salir" textFill="WHITE">
         <font>
            <Font size="34.0" />
         </font>
      </Button>
      <Label fx:id="labelvictoria2" layoutX="47.0" layoutY="38.0" prefHeight="54.0" prefWidth="526.0" text="Label">
         <font>
            <Font name="Arial Black" size="21.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
